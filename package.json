{
  "name": "versecon-link",
  "version": "2.11.29",
  "description": "Star Citizen Log Reader & Overlay Controller for VerseCon",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "build:fast": "electron-builder --win dir",
    "serve-loadout": "node src/api/loadout-api.js",
    "build-data-index": "node scripts/build-data-index.js",
    "update-blueprints": "node scripts/update-blueprint-masterlist.js"
  },
  "keywords": [],
  "author": "VerseCon",
  "license": "ISC",
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "electron-updater": "^6.1.7",
    "express": "^4.22.1",
    "nat-upnp": "^1.1.1",
    "screenshot-desktop": "^1.15.3",
    "socket.io-client": "^4.7.4",
    "tesseract.js": "^7.0.0",
    "ws": "^8.19.0"
  },
  "build": {
    "appId": "com.versecon.link",
    "productName": "Verse Link",
    "win": {
      "icon": "assets/icon.png",
      "target": "nsis",
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": false
    },
    "asarUnpack": [
      "node_modules/screenshot-desktop"
    ],
    "files": [
      "src/**/*",
      "data/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "scripts/**/*",
      "package.json",
      "package-lock.json",
      "!src/**/*.test.js"
    ],
    "publish": {
      "provider": "github",
      "owner": "winstonedd-dversecon",
      "repo": ".gemini"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "protocols": {
      "name": "Verse Link Protocol",
      "schemes": [
        "versecon-link"
      ]
    }
  }
}
